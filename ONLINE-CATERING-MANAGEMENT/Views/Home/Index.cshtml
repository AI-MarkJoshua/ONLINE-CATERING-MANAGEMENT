@{
    ViewData["Title"] = "Home Page";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- HERO SECTION -->
<div class="hero-container">

    <div class="hero-content container">
        <div class="row align-items-center gx-1">

            <!-- LEFT SIDE TEXT -->
            <div class="col-lg-6 hero-text">
                <h4>Catering</h4>
                <h1>Good Food</h1>
                <h2>Great <span>Memories</span></h2>
                <p>We handle the food, preparation, and presentation</p>
                <p>so you can relax and enjoy your special occasion.</p>

                <a asp-controller="Home" asp-action="Menu" class="btn btn-warning btn-lg mt-3">
                    Get Started
                </a>
            </div>

            <!-- RIGHT SIDE IMAGE -->
            <div class="col-lg-6 hero-images">

                <!-- BIG IMAGE -->
                <img src="/image/food2.png" class="food-img main" id="img1">

                <!-- SMALL STACK -->
                <img src="/image/food1.png" class="food-img small s1" onclick="swapImage(this)">
                <img src="/image/food3.png" class="food-img small s2" onclick="swapImage(this)">
                <img src="/image/food4.png" class="food-img small s3" onclick="swapImage(this)">

            </div>

        </div>
    </div>

</div>
<script>
    let autoRotateInterval;
    let isAutoRotating = true;
    let currentImageIndex = 0;

       /* CLICK IMAGE TO BRING IT TO FRONT */
    function swapImage(clickedImg) {

        const main = document.querySelector(".food-img.main");

        // Prevent clicking the main image
        if (clickedImg.classList.contains("main")) return;

        // If user clicked s1
        if (clickedImg.classList.contains("s1")) {

            rotateSmallImages();

        }

        // If user clicked s2
        else if (clickedImg.classList.contains("s2")) {

            rotateSmallImages();

            setTimeout(() => {
                rotateSmallImages();
            }, 850);
        }

        // If user clicked s3
        else if (clickedImg.classList.contains("s3")) {

            rotateSmallImages();

            setTimeout(() => {
                rotateSmallImages();
            }, 850);

            setTimeout(() => {
                rotateSmallImages();
            }, 1700);
        }
    }

         /* SMOOTH CIRCULAR ROTATION */
    function rotateSmallImages() {

        const main = document.querySelector(".food-img.main");
        const s1 = document.querySelector(".food-img.s1");
        const s2 = document.querySelector(".food-img.s2");
        const s3 = document.querySelector(".food-img.s3");

        // Animate movement
        main.classList.add("move-to-s3");
        s1.classList.add("move-to-main");
        s2.classList.add("move-to-s1");
        s3.classList.add("move-to-s2");

        setTimeout(() => {

            // REMOVE OLD POSITION CLASSES
            main.classList.remove("main", "move-to-s3");
            s1.classList.remove("s1", "move-to-main");
            s2.classList.remove("s2", "move-to-s1");
            s3.classList.remove("s3", "move-to-s2");

            // ADD NEW POSITION CLASSES
            main.classList.add("s3");
            s1.classList.add("main");
            s2.classList.add("s1");
            s3.classList.add("s2");

        }, 800);
    }

    /* START AUTO ROTATION */
    function startAutoRotation() {
        autoRotateInterval = setInterval(rotateSmallImages, 4000);
    }

    /* STOP AUTO ROTATION */
    function stopAutoRotation() {
        if (autoRotateInterval) {
            clearInterval(autoRotateInterval);
            isAutoRotating = false;
        }
    }

    /* RESTART AUTO ROTATION AFTER INACTIVITY */
    function restartAutoRotation() {
        setTimeout(() => {
            if (!isAutoRotating) {
                isAutoRotating = true;
                startAutoRotation();
            }
        }, 8000); // Restart after 8 seconds
    }

    /* INITIALIZE WHEN PAGE LOADS */
    document.addEventListener('DOMContentLoaded', function() {
        startAutoRotation();
        
        // Stop rotation on user interaction
        document.querySelectorAll('.food-img').forEach(img => {
            img.addEventListener('click', function() {
                stopAutoRotation();
                restartAutoRotation();
            });
            img.addEventListener('mouseenter', stopAutoRotation);
        });

        // Resume rotation when mouse leaves the image area
        const heroArea = document.querySelector(".hero-images");
        heroArea.addEventListener("mouseleave", function() {
            if (!isAutoRotating) {
                restartAutoRotation();
            }
        });
    });
</script>