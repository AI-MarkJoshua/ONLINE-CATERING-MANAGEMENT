@{
    ViewData["Title"] = "Home Page";
}

<div class="video-container">

    <video autoplay muted loop playsinline class="background-video">
        <source src="videos/samplevideo.mp4" type="video/mp4">
    </video>

    <div class="video-overlay">
        <h1>Delicious Catering For Every Occasion</h1>
        <p>Weddings • Birthdays • Corporate Events</p>

        <a asp-controller="Home" asp-action="Menu" class="btn btn-warning btn-lg mt-3">
            View Menu
        </a>
    </div>

</div>
